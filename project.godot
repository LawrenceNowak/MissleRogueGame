; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="Missile Command x PIT"
run/main_scene="res://game/Main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

fire={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
select_slot_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
select_slot_2={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
pause_game={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.039, 0.078, 1)
